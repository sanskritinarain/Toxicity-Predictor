--- GET /health ---
Request:  {}
Status:   200
Response: {
  "model": "Random Forest",
  "status": "ok"
}

--- POST /predict (CCO) ---
Request:  {"smiles": "CCO"}
Status:   200
Response: {
  "model": "Random Forest",
  "predicted_label": "Non-toxic",
  "smiles": "CCO",
  "threshold": 0.5,
  "toxicity_risk_score": 0.45
}

